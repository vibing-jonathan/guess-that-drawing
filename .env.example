# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Browser origin allowed to connect to the API and Socket.IO server.
# Use http://localhost:5173 for `npm run dev`; use http://localhost:3000
# when running the production container.
WEB_ORIGIN=http://localhost:5173

# Local development connects through the loopback-only Compose port.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_REQUIRED=true

# Used to sign reconnect credentials. Generate a unique value with:
# openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Host port mapped to the production container.
APP_PORT=3000

# The production image sets this automatically.
WEB_DIST_DIR=apps/web/dist
